APP_ORIGIN=http://127.0.0.1:5173
# Local development uses SQLite. Production requires PostgreSQL and Azure Blob.
NODE_ENV=development
DATABASE_URL=
# Only for a local PostgreSQL instance; production always verifies TLS.
PGSSL=
PANTRY_DATA_DIR=
PANTRY_DB=
PANTRY_HOST=127.0.0.1
# Trust only a loopback reverse proxy when 1. App Service uses its own Client-IP.
PANTRY_TRUST_PROXY=0
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=receipts
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback
SEED_SUPERADMIN_EMAIL=Siddharth.Kalyani@intuitive.AI
SEED_SUPERADMIN_NAME=Siddharth Kalyani
SEED_SUPERADMIN_OBJECT_ID=
SESSION_SECRET=
PORT=8787
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=
