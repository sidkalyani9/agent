# Replace placeholders in Azure App Service settings. Never commit actual values.
APP_ENV=production
APP_ORIGIN=https://YOUR-APP.azurewebsites.net
ENTRA_REDIRECT_URI=https://YOUR-APP.azurewebsites.net/api/auth/callback
ENTRA_TENANT_ID=YOUR-TENANT-UUID
ENTRA_CLIENT_ID=YOUR-APP-REGISTRATION-UUID
ENTRA_CLIENT_SECRET=@Microsoft.KeyVault(SecretUri=https://YOUR-VAULT.vault.azure.net/secrets/entra-client-secret/)
SESSION_SECRET=@Microsoft.KeyVault(SecretUri=https://YOUR-VAULT.vault.azure.net/secrets/pantry-session-secret/)
DATABASE_URL=@Microsoft.KeyVault(SecretUri=https://YOUR-VAULT.vault.azure.net/secrets/pantry-database-url/)
SEED_SUPERADMIN_EMAIL=Siddharth.Kalyani@intuitive.AI
SEED_SUPERADMIN_NAME=Siddharth Kalyani
SEED_SUPERADMIN_OBJECT_ID=YOUR-ENTRA-USER-OBJECT-UUID
AZURE_STORAGE_ACCOUNT_URL=https://YOURSTORAGEACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=receipts
# Optional. Leave empty until your company approves sending pantry context to TokenRouter.
TOKENROUTER_API_KEY=
